# Port du serveur backend
PORT=5000

# Compte email utilisé pour l'envoi (ne jamais committer de vrai mot de passe)
EMAIL_USER=fandresenanatolo@gmail.com
EMAIL_PASS=TON_MOT_DE_PASSE_APPLICATION

# Origines frontend autorisées (séparées par des virgules).
# Ajouter ici le domaine de production si besoin.
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://mada-digital-agency-nine.vercel.app

# --- PostgreSQL (demandes du formulaire de contact) ---
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mada_digital_agency
DB_USER=mada_admin
DB_PASSWORD=

# --- Authentification Admin (JWT) ---
# Ne jamais committer de vrais secrets : uniquement des placeholders ici.
JWT_SECRET=TON_SECRET_JWT_ALEATOIRE_LONG
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=TON_MOT_DE_PASSE_ADMINISTRATEUR

